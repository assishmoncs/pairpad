# PairPad backend environment configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

MONGODB_URI=mongodb://127.0.0.1:27017/pairpad

# Redis / horizontal Socket.IO scaling
# Leave blank for single-node local development.
REDIS_URL=
REDIS_REQUIRED=false
PRESENCE_NODE_ID=

# JWT signing secret (long, random, production-only secret)
JWT_SECRET=replace-with-a-secure-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Refresh-token cookie settings
REFRESH_COOKIE_NAME=pairpad_refresh
REFRESH_COOKIE_SAMESITE=lax

# Frontend origin (CORS + Socket.IO). Comma-separated for multiple origins.
CLIENT_URL=http://localhost:5173

# Judge0 code execution (recommended production path)
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=replace-with-your-judge0-key
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# Isolated execution worker (optional; use a dedicated execution host in production)
EXECUTION_WORKER_URL=
EXECUTION_WORKER_TOKEN=
EXECUTION_WORKER_TIMEOUT_MS=7000

# SECURITY: direct in-process host execution is unsafe and must remain disabled in production.
ALLOW_LOCAL_EXECUTION=
