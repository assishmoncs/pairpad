# PairPad backend environment configuration
PORT=5000
NODE_ENV=development

# Structured logging level: fatal | error | warn | info | debug
LOG_LEVEL=debug

# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/pairpad

# JWT settings (use a long random string in production)
JWT_SECRET=replace-with-a-secure-secret
JWT_EXPIRES_IN=7d
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend origin (CORS + Socket.IO). Comma-separated for multiple origins.
CLIENT_URL=http://localhost:5173

# Judge0 code execution (RapidAPI or self-hosted)
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=replace-with-your-judge0-key
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# ⚠️ SECURITY: unsandboxed local code execution.
# Local execution runs user-supplied Node/Python on THIS host and is NOT a
# security boundary. It is disabled in production unless explicitly 'true'.
# Prefer a fully isolated runner (Judge0 / containerized) in production.
ALLOW_LOCAL_EXECUTION=
