# PairPad backend environment configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

MONGODB_URI=mongodb://127.0.0.1:27017/pairpad

# JWT signing secret (long, random, production-only secret)
JWT_SECRET=replace-with-a-secure-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Refresh-token cookie settings
REFRESH_COOKIE_NAME=pairpad_refresh
# lax is suitable for same-site deployments; use none only with HTTPS cross-site deployments.
REFRESH_COOKIE_SAMESITE=lax

# Frontend origin (CORS + Socket.IO). Comma-separated for multiple origins.
CLIENT_URL=http://localhost:5173

# Judge0 code execution (RapidAPI or self-hosted)
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=replace-with-your-judge0-key
JUDGE0_RAPIDAPI_HOST=judge0-ce.p.rapidapi.com

# SECURITY: unsandboxed local code execution is disabled in production by default.
ALLOW_LOCAL_EXECUTION=
